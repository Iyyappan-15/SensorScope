# SensorScope Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# NASA FIRMS API Key
# Request a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_map_key_here

# Optional: Override default region bounding box (west,south,east,north)
# Default is Punjab & Haryana, India
AOI_BBOX=73.8,29.5,77.5,32.5

# Optional: Override default date range for initial data fetch
DATA_START_YEAR=2022
DATA_END_YEAR=2024
